<style>
  .feedback-section {
    padding: 8rem 0;
    position: relative;
    background: linear-gradient(180deg, rgba(13,16,23,0) 0%, rgba(229,62,62,0.05) 100%);
    overflow: hidden;
  }
  
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  
  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 1rem;
  }
  
  .highlight {
    color: #e53e3e;
  }
  
  .section-description {
    color: #9ca3af;
    max-width: 600px;
    margin: 0 auto;
    font-size: 1rem;
  }
  
  .feedback-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 1rem;
  }
  
  .feedback-item {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    padding: 1.8rem;
    height: 100%;
    transition: all 0.3s ease;
  }
  
  .feedback-item:hover {
    transform: translateY(-5px);
    border-color: rgba(229,62,62,0.2);
    background: rgba(255,255,255,0.05);
  }
  
  .feedback-content {
    position: relative;
    padding-left: 1rem;
    margin-bottom: 1.5rem;
    color: #d1d5db;
    font-style: italic;
    line-height: 1.6;
  }
  
  .feedback-content:before {
    content: '"';
    position: absolute;
    top: -1rem;
    left: -0.5rem;
    font-size: 4rem;
    color: rgba(229,62,62,0.2);
    font-family: Georgia, serif;
    line-height: 1;
  }
  
  .feedback-meta {
    border-top: 1px solid rgba(255,255,255,0.05);
    padding-top: 1rem;
  }
  
  .rating {
    margin-bottom: 0.8rem;
  }
  
  .rating i {
    color: #e53e3e;
    margin-right: 3px;
  }
  
  .verification {
    display: flex;
    align-items: center;
    font-size: 0.85rem;
    color: #9ca3af;
  }
  
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #e53e3e;
    color: white;
    margin-right: 8px;
    font-size: 0.7rem;
  }
  
  @media (max-width: 768px) {
    .feedback-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

