{#
  PRODUKT-SEKTION - V3 (Modern Glassmorphism Redesign)
#}
<style>
  .cp-section {
    padding: 4rem 0 5rem;
  }

  /* ── Section Header ── */
  .cp-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.85rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    margin-bottom: 1.1rem;
  }
  .cp-kicker i { color: var(--cl-accent, #e53e3e); }

  .cp-title {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800;
    color: #f5f7ff;
    margin-bottom: 0.6rem;
    position: relative;
    display: inline-block;
  }
  .cp-title::after {
    content: '';
    position: absolute;
    left: 50%; bottom: -6px;
    transform: translateX(-50%);
    width: 60px; height: 3px;
    background: var(--cl-accent, #e53e3e);
    border-radius: 2px;
    box-shadow: 0 0 12px var(--cl-accent, #e53e3e);
  }

  .cp-subtitle {
    font-size: 1rem;
    color: rgba(255,255,255,0.50);
    margin-top: 1.2rem;
  }

  /* ── Filter Buttons ── */
  .cp-filters {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin: 2rem 0 2.5rem;
  }
  .cp-filter-btn {
    padding: 0.4rem 1.1rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 99px;
    color: rgba(255,255,255,0.55);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.22s, border-color 0.22s, color 0.22s;
  }
  .cp-filter-btn:hover { background: rgba(255,255,255,0.10); color: #fff; }
  .cp-filter-btn.cp-filter-active {
    background: var(--cl-accent, #e53e3e);
    border-color: var(--cl-accent, #e53e3e);
    color: #fff;
    box-shadow: 0 0 16px rgba(0,0,0,0.3);
  }

  /* ── Product Grid ── */
  .cp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    width: 100%;
  }

  /* ── Product Card ── */
  .cp-product-item {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.025);
    backdrop-filter: blur(12px);
    overflow: hidden;
    box-shadow: 0 14px 40px rgba(0,0,0,0.8);
    transition:
      transform 0.28s cubic-bezier(.25,.8,.25,1),
      border-color 0.28s,
      box-shadow 0.28s;
    cursor: pointer;
  }
  .cp-product-item:hover {
    transform: translateY(-6px);
    border-color: rgba(255,255,255,0.28);
    box-shadow:
      0 22px 55px rgba(0,0,0,0.9),
      0 0 40px rgba(255,255,255,0.04);
  }

  /* ── Card Image ── */
  .cp-card-img-wrap {
    position: relative;
    width: 100%;
    padding-top: 55%;
    overflow: hidden;
    background: rgba(0,0,0,0.4);
  }
  .cp-card-img {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 0.38s cubic-bezier(.25,.8,.25,1);
  }
  .cp-product-item:hover .cp-card-img { transform: scale(1.08); }
  .cp-card-img-placeholder {
    position: absolute;
    inset: 0;
    display: flex; align-items: center; justify-content: center;
    color: rgba(255,255,255,0.12);
    font-size: 3rem;
    background: linear-gradient(135deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
  }

  .cp-card-img-gradient {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(8,10,13,0.9), transparent);
    pointer-events: none;
    z-index: 1;
  }

  /* Badges (top-left) */
  .cp-card-badges {
    position: absolute;
    top: 0.65rem; left: 0.65rem;
    display: flex; gap: 0.35rem;
    flex-wrap: wrap;
    z-index: 2;
  }
  .cp-card-badge {
    padding: 0.2rem 0.55rem;
    background: rgba(12,14,18,0.75);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 99px;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    backdrop-filter: blur(8px);
  }
  .cp-card-badge.accent { background: var(--cl-accent, #e53e3e); border-color: transparent; color: #fff; }

  /* CTA overlay on hover */
  .cp-card-cta-overlay {
    position: absolute;
    inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(8,10,13,0.45);
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 3;
  }
  .cp-product-item:hover .cp-card-cta-overlay { opacity: 1; }
  .cp-card-cta-btn {
    padding: 0.55rem 1.4rem;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 8px;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
    pointer-events: none;
  }

  /* ── Card Body ── */
  .cp-card-body {
    padding: 1rem 1.15rem 1.2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .cp-card-name {
    font-size: 1rem;
    font-weight: 700;
    color: #f5f7ff;
    margin-bottom: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cp-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
  }
  .cp-card-price {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--cl-accent, #e53e3e);
    text-shadow: 0 0 10px rgba(0,0,0,0.5);
  }
  .cp-card-stock {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
  }
  .cp-stock-in  { background: rgba(16,217,141,0.12); color: #10d98d; border: 1px solid rgba(16,217,141,0.25); }
  .cp-stock-out { background: rgba(255,80,80,0.12);  color: #ff5050;  border: 1px solid rgba(255,80,80,0.25); }

  /* ── Group Modal ── */
  .cp-modal-design {
    background: radial-gradient(circle at 50% 0%, rgba(255,255,255,0.04), transparent 40%), rgba(14,17,23,0.97);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 1.25rem;
    position: relative;
    backdrop-filter: blur(24px);
  }
  .group-modal-item {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
</style>

<section
  id="{{ componentId }}"
  class="component cp-section"
  data-component-id="{{ componentId }}"
  x-data="{
    searchTerm: '',
    activeFilter: 'all',
    openGroupModalId: null,
    openGroupModal(id) {
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.paddingRight = `${scrollbarWidth}px`;
      document.body.style.overflow = 'hidden';
      this.openGroupModalId = id;
      
      this.$nextTick(() => {
        const items = document.querySelectorAll(`.modal-${id} .group-modal-item`);
        items.forEach((item, index) => {
          setTimeout(() => {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
          }, 250 + (index * 90));
        });
      });
    },
    closeGroupModal() {
      document.body.style.overflow = 'auto';
      document.body.style.paddingRight = '0px';
      this.openGroupModalId = null;
    }
  }"
>
  <div class="container mx-auto px-4">

    <!-- HEADER -->
    <div class="flex flex-col items-center text-center mb-2">
      <span class="cp-kicker"><i class="fas fa-star"></i> FEATURED</span>
      <h2 class="cp-title" data-dsr>Explore Our Products</h2>
      <p class="cp-subtitle" data-dsr>Discover our range of products designed to enhance your gaming experience.</p>
    </div>

    <!-- FILTER BUTTONS -->
    <div class="cp-filters">
      <button class="cp-filter-btn" :class="{ 'cp-filter-active': activeFilter === 'all' }" @click="activeFilter = 'all'">All</button>
      <button class="cp-filter-btn" :class="{ 'cp-filter-active': activeFilter === 'single' }" @click="activeFilter = 'single'">Singles</button>
      <button class="cp-filter-btn" :class="{ 'cp-filter-active': activeFilter === 'group' }" @click="activeFilter = 'group'">Groups</button>
    </div>

    {% if properties.show_searchbar %}
      <div class="flex items-center gap-4 w-full mb-6 bg-white/5 text-accent-200 rounded-xl px-4 cursor-pointer focus-within:ring-2 focus-within:ring-accent-500" data-dsr>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24"><path fill="currentColor" d="M9.5 16q-2.725 0-4.612-1.888T3 9.5t1.888-4.612T9.5 3t4.613 1.888T16 9.5q0 1.1-.35 2.075T14.7 13.3l5.6 5.6q.275.275.275.7t-.275.7t-.7.275t-.7-.275l-5.6-5.6q-.75.6-1.725.95T9.5 16m0-2q1.875 0 3.188-1.312T14 9.5t-1.312-3.187T9.5 5T6.313 6.313T5 9.5t1.313 3.188T9.5 14"/></svg>
        <input x-model="searchTerm" type="text" class="flex-1 py-4 bg-transparent focus:outline-none" placeholder="Search for products..." />
      </div>
    {% endif %}

    <!-- PRODUCT GRID -->
    <div
      x-data
      x-init="() => {
        import('https://cdn.jsdelivr.net/npm/@formkit/auto-animate')
          .then(module => module.default($el));
      }"
      class="cp-grid"
      id="cpProductGrid"
    >
      {% if properties.ids|length == 0 %}
        {% for product in sortedItems %}
          {% if product.type == 'group' or not product.group_id %}
            {% set productType = 'group' if product.type == 'group' else 'single' %}
            <div
              x-show="(searchTerm == '' || '{{ product.name | lower }}'.includes(searchTerm.toLowerCase())) && (activeFilter === 'all' || activeFilter === '{{ productType }}')"
              x-transition
              x-cloak
              class="cp-product-item"
              data-type="{{ productType }}"
              {% if product.type == 'group' %}
                @click="openGroupModal('{{ product.id }}')"
              {% else %}
                onclick="window.location.href='{{ ('/product/' + product.slug) | shopUrl }}'"
              {% endif %}
            >
              <!-- Image -->
              <div class="cp-card-img-wrap">
                {% if product.image_url %}
                  <img class="cp-card-img" src="{{ product.image_url }}" alt="{{ product.name }}" loading="lazy">
                {% else %}
                  <div class="cp-card-img-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                  </div>
                {% endif %}
                <div class="cp-card-img-gradient"></div>
                <div class="cp-card-badges">
                  {% if product.type == 'group' %}
                    <span class="cp-card-badge accent">Bundle</span>
                  {% endif %}
                  {% if product.stock == 0 %}
                    <span class="cp-card-badge">Out of Stock</span>
                  {% endif %}
                </div>
                <div class="cp-card-cta-overlay">
                  <span class="cp-card-cta-btn">View Details</span>
                </div>
              </div>
              <!-- Body -->
              <div class="cp-card-body">
                <div class="cp-card-name">{{ product.name }}</div>
                <div class="cp-card-meta">
                  <span class="cp-card-price">
                    {% if product.type == 'group' %}
                      Bundle
                    {% elif product.variants | length > 0 %}
                      From {{ product.currency }} {{ product.variants | map(attribute='price') | min | round(2) }}
                    {% else %}
                      &mdash;
                    {% endif %}
                  </span>
                  {% if product.type != 'group' %}
                    {% if product.stock == 0 %}
                      <span class="cp-card-stock cp-stock-out">Out of Stock</span>
                    {% else %}
                      <span class="cp-card-stock cp-stock-in">In Stock</span>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for product in helpers.components.products.getItemsByIds(sortedItems, properties.ids) %}
          {% set productType = 'group' if product.type == 'group' else 'single' %}
          <div
            x-show="(searchTerm == '' || '{{ product.name | lower }}'.includes(searchTerm.toLowerCase())) && (activeFilter === 'all' || activeFilter === '{{ productType }}')"
            x-transition
            x-cloak
            class="cp-product-item"
            data-type="{{ productType }}"
            {% if product.type == 'group' %}
              @click="openGroupModal('{{ product.id }}')"
            {% else %}
              onclick="window.location.href='{{ ('/product/' + product.slug) | shopUrl }}'"
            {% endif %}
          >
            <div class="cp-card-img-wrap">
              {% if product.image_url %}
                <img class="cp-card-img" src="{{ product.image_url }}" alt="{{ product.name }}" loading="lazy">
              {% else %}
                <div class="cp-card-img-placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="currentColor"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
                </div>
              {% endif %}
              <div class="cp-card-img-gradient"></div>
              <div class="cp-card-badges">
                {% if product.type == 'group' %}
                  <span class="cp-card-badge accent">Bundle</span>
                {% endif %}
                {% if product.stock == 0 %}
                  <span class="cp-card-badge">Out of Stock</span>
                {% endif %}
              </div>
              <div class="cp-card-cta-overlay">
                <span class="cp-card-cta-btn">View Details</span>
              </div>
            </div>
            <div class="cp-card-body">
              <div class="cp-card-name">{{ product.name }}</div>
              <div class="cp-card-meta">
                <span class="cp-card-price">
                  {% if product.type == 'group' %}
                    Bundle
                  {% elif product.variants | length > 0 %}
                    From {{ product.currency }} {{ product.variants | map(attribute='price') | min | round(2) }}
                  {% else %}
                    &mdash;
                  {% endif %}
                </span>
                {% if product.type != 'group' %}
                  {% if product.stock == 0 %}
                    <span class="cp-card-stock cp-stock-out">Out of Stock</span>
                  {% else %}
                    <span class="cp-card-stock cp-stock-in">In Stock</span>
                  {% endif %}
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div><!-- /cp-grid -->

  </div>

  <!-- GROUP MODALS -->
  {% for product_group in sortedItems %}
  {% if product_group.type == 'group' %}
  <div x-show="openGroupModalId == '{{ product_group.id }}'" class="fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true" style="display: none;">
    <div class="flex items-center justify-center min-h-screen px-4 text-center">
        <div x-cloak @click="closeGroupModal" x-show="openGroupModalId == '{{ product_group.id }}'"
          x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
          x-transition:leave="transition ease-in duration-200" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
          class="fixed inset-0 transition-opacity bg-black/70 backdrop-blur-md" aria-hidden="true"
        ></div>

        <div
          x-cloak
          x-show="openGroupModalId == '{{ product_group.id }}'"
          x-transition:enter="transition-all ease-[cubic-bezier(0.34,1.56,0.64,1)] duration-500"
          x-transition:enter-start="opacity-0 translate-y-8 scale-90"
          x-transition:enter-end="opacity-100 translate-y-0 scale-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-95"
          class="modal-{{ product_group.id }} cp-modal-design relative inline-block w-full max-w-2xl my-8 overflow-hidden text-left align-middle shadow-2xl shadow-black/50"
        >
          <div class="relative text-center px-6 py-4">
            <h3 class="text-xl font-bold text-white">{{ product_group.name }}</h3>
            <button @click="closeGroupModal" class="absolute top-0 right-0 mt-3 mr-5 p-2 text-white/50 transition-colors rounded-full focus:outline-none hover:bg-white/10 hover:text-white">
              <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24"><path fill="currentColor" d="m12 13.4l-4.9 4.9q-.275.275-.7.275t-.7-.275t-.275-.7t.275-.7l4.9-4.9l-4.9-4.9q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l4.9 4.9l4.9-4.9q.275.275.7-.275t.7.275t.275.7t-.275.7L13.4 12l4.9 4.9q.275.275.275.7t-.275.7t-.7.275t-.7-.275z"/></svg>
            </button>
          </div>
          <div class="flex flex-col gap-1 p-4">
            {% for product in product_group.products %}
              <div class="group-modal-item">
                {% render_snippet "product-card-horizontal.njk", product=product %}
              </div>
            {% endfor %}
          </div>
        </div>
    </div>
  </div>
  {% endif %}
  {% endfor %}

</section>
