<style>
  @keyframes heroSlideUp {
    from { opacity: 0; transform: translateY(35px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes heroFade {
    from { opacity: 0; transform: scale(1.03); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes blink-cursor {
    0%, 100% { border-color: var(--cl-accent, #e53e3e); }
    50%       { border-color: transparent; }
  }
  @keyframes typewriter {
    from { width: 0; }
    to   { width: 100%; }
  }

  .hero-cinematic {
    position: relative;
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://i.imgur.com/4ocSJUP.png');
    background-size: cover;
    background-position: center top;
    filter: brightness(0.45);
    animation: heroFade 1.1s cubic-bezier(.25,.8,.25,1) both;
    z-index: 0;
  }

  .hero-cinematic::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 40%;
    background: linear-gradient(to bottom, rgba(8,10,13,1) 0%, transparent 100%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-cinematic::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(8,10,13,1) 0%, transparent 100%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-center {
    position: relative;
    z-index: 2;
    max-width: 900px;
    width: 100%;
    padding: 4rem 1.5rem;
    text-align: center;
    animation: heroSlideUp 0.8s 0.15s cubic-bezier(.25,.8,.25,1) both;
  }

  .hero-brand-label {
    display: inline-block;
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .hero-typewriter-wrap {
    display: block;
    font-size: clamp(1rem, 3vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cl-accent, #e53e3e);
    margin-bottom: 1.75rem;
  }
  .hero-typewriter {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 3px solid var(--cl-accent, #e53e3e);
    animation:
      typewriter 1.4s steps(22, end) 0.6s both,
      blink-cursor 0.75s step-end 0.6s infinite;
    max-width: 100%;
  }

  .hero-subtitle-cin {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: rgba(255,255,255,0.65);
    line-height: 1.65;
    max-width: 620px;
    margin: 0 auto 2.25rem;
  }
  .hero-subtitle-cin strong { color: var(--cl-accent, #e53e3e); font-weight: 600; }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 1rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 99px;
    color: rgba(255,255,255,0.8);
    font-size: 0.82rem;
    font-weight: 500;
    backdrop-filter: blur(8px);
  }

  .hero-cta-cin {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.85rem 2.2rem;
    background: var(--cl-accent, #e53e3e);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    border-radius: 10px;
    text-decoration: none;
    transition: opacity 0.22s ease, transform 0.18s ease, box-shadow 0.22s ease;
    box-shadow: 0 6px 24px rgba(0,0,0,0.4);
    position: relative;
    overflow: hidden;
  }
  .hero-cta-cin::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.18) 50%, transparent 70%);
    transform: translateX(-100%);
    transition: transform 0.55s ease;
  }
  .hero-cta-cin:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 12px 32px rgba(0,0,0,0.5); color: #fff; }
  .hero-cta-cin:hover::before { transform: translateX(100%); }
  .hero-cta-cin svg { width: 18px; height: 18px; flex-shrink: 0; }
</style>

<section class="hero-cinematic component" data-component-id="hero">
  <div class="hero-bg"></div>

  <div class="hero-center">
    <span class="hero-brand-label">SkyWare</span>
    <span class="hero-typewriter-wrap">
      <span class="hero-typewriter">HIGH QUALITY CHEATS</span>
    </span>

    <p class="hero-subtitle-cin">
      Experience advanced gaming enhancements, <strong>undetected</strong> &amp; private.
      Blazing fast. Ultra secure. <strong>Ready for champions.</strong>
    </p>

    <div class="hero-badges">
      <span class="hero-badge">⚡ Instant Delivery</span>
      <span class="hero-badge">🛡️ Undetected &amp; Private</span>
      <span class="hero-badge">🌐 Ready for Champions</span>
    </div>

    <a href="/#products" class="hero-cta-cin">
      Browse Products
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 5L20 12L13 19M4 12H20"/>
      </svg>
    </a>
  </div>
</section>