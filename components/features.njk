<section class="component" data-component-id="{{ componentId }}" style="padding: 4rem 0;">
  <div class="container">
    <div class="section-header text-center mb-5">
      {% if properties.title %}
      <h2 class="section-title" style="font-size: 2.5rem; font-weight: 700; color: #fff;">
        {{ properties.title | safe }}
      </h2>
      {% endif %}
      {% if properties.subtitle %}
      <p class="section-subtitle" style="color: #9ca3af; max-width: 600px; margin: 1rem auto 0;">
        {{ properties.subtitle | safe }}
      </p>
      {% endif %}
    </div>

    <div class="row g-4 justify-content-center">
      {% for feature in properties.features %}
        <div class="col-12 col-sm-6 col-lg-3">
          <div class="feature-card">
            <div class="feature-icon-wrapper">
              <i class="{{ feature.icon | default('fas fa-star') }}"></i>
            </div>
            <h5 class="feature-title">{{ feature.title | default('Feature Title') }}</h5>
            <p class="feature-description">{{ feature.description | default('Feature description goes here.') }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.feature-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--cl-border);
  border-radius: 12px;
  padding: 2rem 1.5rem;
  text-align: center;
  height: 100%;
  transition: all 0.3s ease;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.feature-card:hover {
  transform: translateY(-5px);
  border-color: var(--cl-accent);
  background: rgba(var(--cl-accent-rgb, 255, 136, 0), 0.05);
}

.feature-icon-wrapper {
  width: 50px;
  height: 50px;
  margin: 0 auto 1.5rem auto;
  background-color: var(--cl-accent);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 1.5rem;
  transition: all 0.3s ease;
}

.feature-card:hover .feature-icon-wrapper {
    transform: rotate(10deg) scale(1.1);
    box-shadow: 0 0 20px rgba(var(--cl-accent-rgb, 255, 136, 0), 0.5);
}

.feature-title {
  font-size: 1.2rem;
  font-weight: 600;
  color: #fff;
  margin-bottom: 0.5rem;
}

.feature-description {
  color: #9ca3af;
  font-size: 0.95rem;
  line-height: 1.6;
}
</style>