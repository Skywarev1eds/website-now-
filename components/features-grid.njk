<section class="cryptic-features component" data-component-id="{{ componentId }}">
    <div class="container">
        <div class="text-center">
            <div class="mb-4">
                <span class="hero-11-badge">DISCORD.GG/HEXWAARE</span>
            </div>
            <h1 class="hero-11-title mb-3">EASY USAGE</h1>
            <p class="hero-11-subtitle mb-1">Advanced user interface &amp; easy navigation</p>
        </div>

        <div class="cf-grid">
            <article class="fcard f-progress" data-reveal="">
                <div class="f-glow"></div>
                <div class="f-inner">
                    <div class="ring-wrap" data-progress="80">
                        <svg viewBox="0 0 120 120" class="ring" aria-hidden="true">
                            <defs>
                                <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="var(--cl-accent)"></stop>
                                    <stop offset="100%" stop-color="{{ global.properties.theme_color | default('#ff0000') | replace('#', '') | hex_to_rgb | darken(20) | rgb_to_hex }}"></stop>
                                </linearGradient>
                            </defs>
                            <circle class="track" cx="60" cy="60" r="50"></circle>
                            <circle class="bar" cx="60" cy="60" r="50" stroke="url(#ringGrad)"></circle>
                        </svg>
                        <div class="ring-center">
                            <small>Payment Status</small>
                            <strong class="ring-val">0%</strong>
                        </div>
                    </div>
                    <h4><b>Instant Delivery.</b> Receive your order directly after payment!</h4>
                </div>
            </article>

            <article class="fcard f-key" data-reveal="">
                <div class="f-glow"></div>
                <div class="f-inner">
                    <div class="cryptic-licbox" data-key="HEXWARE-123-KEY-1337">
                        <h5 class="clb-title">Enter your key</h5>
                        <div class="clb-input"><input type="text" placeholder="HEXWARE-123-KEY-1337" readonly=""></div>
                        <button class="clb-btn" type="button"><i class="fa-solid fa-bolt"></i> REDEEM LICENSE KEY</button>
                        <div class="clb-stage" aria-hidden="true">
                            <div class="clb-spinner"><svg viewBox="0 0 100 100"><circle class="clb-track" cx="50" cy="50" r="32"></circle><circle class="clb-arc" cx="50" cy="50" r="32"></circle></svg></div>
                            <div class="clb-status"></div>
                            <div class="clb-success"><div class="clb-check"><i></i></div><div class="clb-success-text">Successfully Injected</div></div>
                        </div>
                        <div class="clb-pointer" aria-hidden="true"></div>
                    </div>
                    <h4><b>One Click Setup.</b> Instantly inject our cheats with one-click!</h4>
                </div>
            </article>

            <article class="fcard f-chat" data-reveal="">
                <div class="f-glow"></div>
                <div class="f-inner">
                    <div class="chat" aria-live="polite">
                        <div class="bubble bubble--sys" data-delay="900"><b>Hello!</b> How can we assist you?</div>
                        <div class="bubble bubble--me" data-delay="700">I need help with my order.</div>
                        <div class="bubble bubble--me" data-delay="750">Can you guys help me?</div>
                        <div class="bubble bubble--sys bubble--mini" data-delay="900">For sure!</div>
                    </div>
                    <h4><b>24/7 Customer Service.</b> Our team is always active to resolve issues!</h4>
                </div>
            </article>

            <article class="fcard f-ui" data-reveal="">
                 <div class="f-glow"></div>
                 <div class="f-inner">
                     <div class="ui-topbar"><span class="menu-name">⚙ HEXWARE EXTERNAL</span></div>
                     <div class="ui-demo ui-modern">
                         <aside class="tabs" role="tablist">
                             <button class="tab is-active" role="tab" aria-selected="true">AIMBOT</button>
                             <button class="tab" role="tab" aria-selected="false">PLAYERS</button>
                             <button class="tab" role="tab" aria-selected="false">ITEMS</button>
                             <button class="tab" role="tab" aria-selected="false">KEYS</button>
                         </aside>
                         <div class="ui-body">
                            <div class="ui-col" data-tab-content="AIMBOT"><div class="row"><span>Field of View</span><div class="slider" data-walk="55"><i style="left:55%"></i></div></div><div class="row"><span>Smoothness</span><div class="slider"><i style="left:35%"></i></div></div><div class="row"><span>Visible Check</span><label class="tgl is-checked"><input type="checkbox" checked><i></i></label></div></div>
                            <div class="ui-col" data-tab-content="PLAYERS" style="display: none;"><div class="row"><span>Show Players</span><label class="tgl is-checked"><input type="checkbox" checked><i></i></label></div><div class="row"><span>Show Health</span><div class="slider"><i style="left:70%"></i></div></div></div>
                            <div class="ui-col" data-tab-content="ITEMS" style="display: none;"><div class="row"><span>Item ESP</span><label class="tgl is-checked"><input type="checkbox" checked><i></i></label></div><div class="row"><span>Item Distance</span><div class="slider"><i style="left:40%"></i></div></div></div>
                            <div class="ui-col" data-tab-content="KEYS" style="display: none;"><div class="row"><span>Aimbot Toggle</span><button class="key-binding">INSERT</button></div><div class="row"><span>Menu Toggle</span><button class="key-binding">DELETE</button></div></div>
                         </div>
                     </div>
                     <div class="scribble"><span>The menu is interactive<br>Give it a try!</span><i></i></div>
                     <h4><b>Premium User Interface.</b> A unified, high-end design across all products.</h4>
                 </div>
            </article>

            <article class="fcard f-safe" data-reveal="">
                <div class="f-glow"></div>
                <div class="f-inner">
                    <div class="safe-core"><i class="fa-solid fa-shield"></i><span class="orbit"></span><i class="spark s1"></i><i class="spark s2"></i><i class="spark s3"></i><span class="ripple r1"></span><span class="ripple r2"></span><span class="ripple r3"></span></div>
                    <h4><b>Safe & Quality.</b> We offer you the safest and best premium products on the market.</h4>
                    <ul class="safe-points">
                        <li><i class="fa-solid fa-shield-halved"></i> Undetected Builds</li>
                        <li><i class="fa-solid fa-rotate"></i> Auto Updates</li>
                        <li><i class="fa-solid fa-microchip"></i> HWID Spoofer</li>
                        <li><i class="fa-solid fa-angles-down"></i> Easy Installation</li>
                    </ul>
                    <div class="safe-band"><span class="sb-grid"></span><span class="sb-sweep"></span><i class="sb-blip b1"></i><i class="sb-blip b2"></i><i class="sb-blip b3"></i></div>
                </div>
            </article>
        </div>
    </div>
</section>

<style>
/* Base Styles */
.cryptic-features{padding:5rem 0;position:relative;overflow:hidden}.cryptic-features .container{position:relative;z-index:2}.hero-11-badge{display:inline-block;background:rgba(255,0,0,.1);border:1px solid rgba(255,0,0,.2);color:var(--cl-accent,#ff0000);padding:.25rem .75rem;border-radius:99px;font-weight:500;font-size:.8rem}.hero-11-title{font-weight:700;color:#fff}.hero-11-subtitle{color:#b5b9c5}
/* Grid */
.cf-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;margin-top:3rem}
/* Feature Card */
.fcard{background:linear-gradient(145deg, #121212, #0c0c0c);border:1px solid #ffffff1a;border-radius:12px;padding:1.5rem;position:relative;overflow:hidden;transition:transform .3s,border-color .3s}.fcard:hover{transform:translateY(-5px);border-color:#ffffff33}.fcard h4{font-size:1.1rem;font-weight:500;margin-top:1.5rem;color:#fff}
.f-glow{position:absolute;top:0;left:0;width:150px;height:150px;background:var(--cl-accent,#ff0000);filter:blur(100px);opacity:0;transition:opacity .4s;pointer-events:none}.fcard:hover .f-glow{opacity:.2}
/* Progress Ring */
.ring-wrap{width:120px;height:120px;margin:0 auto;position:relative}.ring{transform:rotate(-90deg)}.track{fill:none;stroke:#ffffff1a;stroke-width:8}.bar{fill:none;stroke-width:8;stroke-linecap:round;transition:stroke-dashoffset .8s ease}.ring-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff}.ring-center small{font-size:.7rem;color:#b5b9c5}.ring-center strong{font-size:1.5rem;font-weight:600}
/* Key Redeemer */
.cryptic-licbox{background:#0a0a0a;border-radius:8px;padding:1rem;text-align:center;position:relative}.clb-title{font-size:.9rem;color:#b5b9c5;margin-bottom:.5rem}.clb-input input{width:100%;background:#1a1a1a;border:1px solid #ffffff1a;border-radius:6px;color:#fff;padding:.5rem;text-align:center;font-family:monospace}.clb-btn{width:100%;background:var(--cl-accent,#ff0000);color:#fff;border:none;border-radius:6px;padding:.75rem;margin-top:.75rem;font-weight:600;transition:background .2s}.clb-btn:hover{background:#cc0000}.clb-stage{position:absolute;inset:0;background:rgba(10,10,10,.9);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;flex-direction:column;opacity:0;visibility:hidden;transition:all .3s}.clb-stage.is-open{opacity:1;visibility:visible}.clb-spinner svg{width:40px;height:40px}.clb-track{fill:none;stroke:#ffffff1a;stroke-width:8}.clb-arc{fill:none;stroke:var(--cl-accent,#ff0000);stroke-width:8;stroke-linecap:round;stroke-dasharray:100.53;stroke-dashoffset:100.53;animation:clb-spin 1s linear infinite}.clb-status{color:#fff;margin-top:.5rem}.clb-success{display:none;flex-direction:column;align-items:center}.clb-success.show{display:flex}.clb-check{width:40px;height:40px;border-radius:50%;background:var(--cl-accent,#ff0000);display:flex;align-items:center;justify-content:center;animation:clb-check-pop .3s ease-out}.clb-check i{width:20px;height:10px;border:3px solid #fff;border-top:0;border-right:0;transform:rotate(-45deg) translateY(-2px)}.clb-success-text{color:#fff;margin-top:.5rem;animation:clb-fade-in .3s .2s ease both}.clb-pointer{position:absolute;width:24px;height:24px;background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23ffffff"><path d="M6.3,13.9L10.8,12.3L12.3,10.8L13.9,6.3L15.4,12.3L21,13.9L15.4,15.4L13.9,21L12.3,15.4L6.3,13.9Z"/></svg>');opacity:0}
@keyframes clb-spin{to{transform:rotate(360deg)}}@keyframes clb-check-pop{0%{transform:scale(.8);opacity:0}100%{transform:scale(1);opacity:1}}@keyframes clb-fade-in{0%{opacity:0;transform:translateY(10px)}100%{opacity:1;transform:translateY(0)}}
/* Chat */
.chat{display:flex;flex-direction:column;gap:.5rem}.bubble{padding:.5rem 1rem;border-radius:12px;max-width:80%;font-size:.9rem}.bubble--sys{background:#ffffff1a;color:#fff;align-self:flex-start}.bubble--me{background:var(--cl-accent,#ff0000);color:#fff;align-self:flex-end}.bubble.cf-in{animation:cfPopIn .42s cubic-bezier(.22,1,.36,1) forwards}
@keyframes cfPopIn{0%{opacity:0;transform:translateY(10px) scale(.96)}70%{opacity:1;transform:translateY(0) scale(1.04)}100%{opacity:1;transform:translateY(0) scale(1)}}
/* UI Demo */
.ui-topbar{background:#0a0a0a;padding:.5rem;text-align:center;border-radius:8px 8px 0 0;font-weight:600;color:#b5b9c5}.ui-demo{background:#1a1a1a;border:1px solid #ffffff1a;border-radius:8px;overflow:hidden}.ui-modern{display:flex}.tabs{display:flex;flex-direction:column;padding:.5rem;border-right:1px solid #ffffff1a}.tab{background:0 0;border:0;color:#b5b9c5;padding:.5rem 1rem;border-radius:6px;font-weight:500;cursor:pointer;text-align:left}.tab.is-active{background:var(--cl-accent,#ff0000);color:#fff}.ui-body{padding:1rem;flex-grow:1}.ui-col .row{display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;color:#fff}.tgl{position:relative;display:inline-block;width:40px;height:20px;cursor:pointer}.tgl input{opacity:0;width:0;height:0}.tgl i{position:absolute;inset:0;background:#333;border-radius:20px;transition:.3s}.tgl i::before{content:'';position:absolute;height:16px;width:16px;left:2px;bottom:2px;background:#fff;border-radius:50%;transition:.3s}.tgl.is-checked i{background:var(--cl-accent,#ff0000)}.tgl.is-checked i::before{transform:translateX(20px)}.slider{position:relative;width:100px;height:4px;background:#333;border-radius:2px;cursor:pointer}.slider i{position:absolute;width:12px;height:12px;background:#fff;border-radius:50%;top:-4px;transform:translateX(-50%)}.key-binding{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);color:#fff;padding:.25rem .5rem;border-radius:4px;font-size:.8rem}
/* Safe Card */
.safe-core{position:relative;width:100px;height:100px;margin:0 auto;display:flex;align-items:center;justify-content:center}.safe-core .fa-shield{font-size:3rem;color:var(--cl-accent,#ff0000);z-index:2;animation:shield-pulse 2s infinite ease-in-out}.orbit{position:absolute;width:100%;height:100%;border:2px dashed #ffffff26;border-radius:50%;animation:clb-spin 20s linear infinite}.spark{position:absolute;width:4px;height:4px;background:#fff;border-radius:50%;z-index:3;animation:spark-orbit 4s linear infinite}.s1{top:0;left:50%;transform:translate(-50%,-50%)}.s2{bottom:15%;left:15%;animation-delay:.5s}.s3{top:20%;right:10%;animation-delay:1s}.ripple{position:absolute;width:100%;height:100%;border-radius:50%;background:var(--cl-accent,#ff0000);opacity:0;transform:scale(.5);animation:ripple-wave 3s infinite ease-out}.r2{animation-delay:1s}.r3{animation-delay:2s}.safe-points{list-style:none;padding:0;margin-top:1.5rem;color:#b5b9c5}.safe-points li{margin-bottom:.5rem}.safe-points i{color:var(--cl-accent,#ff0000);margin-right:.5rem}.safe-band{position:absolute;bottom:0;left:0;right:0;height:40px;background:linear-gradient(#0c0c0c00,#0c0c0c);overflow:hidden}.sb-grid{position:absolute;inset:0;background-image:linear-gradient(#ffffff1a 1px,transparent 1px),linear-gradient(to right,#ffffff1a 1px,transparent 1px);background-size:10px 10px;opacity:.5}
@keyframes shield-pulse{50%{transform:scale(1.1)}}@keyframes spark-orbit{0%{transform:rotate(0)translateX(50px)rotate(0)}100%{transform:rotate(360deg)translateX(50px)rotate(-360deg)}}@keyframes ripple-wave{0%{transform:scale(.5);opacity:.2}100%{transform:scale(1.5);opacity:0}}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const wait = (ms) => new Promise(res => setTimeout(res, ms));

    // --- INTERSECTION OBSERVER FOR REVEAL ANIMATION ---
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.setAttribute('data-revealed', 'true');
            }
        });
    }, { threshold: 0.1 });
    document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));

    // --- PROGRESS RING ANIMATION ---
    document.querySelectorAll('.ring-wrap').forEach(wrap => {
        const bar = wrap.querySelector('.bar');
        const valEl = wrap.querySelector('.ring-val');
        if (!bar || !valEl) return;
        const r = parseFloat(bar.getAttribute('r')) || 50;
        const C = Math.PI * 2 * r;
        bar.style.strokeDasharray = C;
        let p = 0;
        const targetP = parseInt(wrap.dataset.progress || '0', 10);
        
        const tick = () => {
            p = Math.min(p + 2, targetP);
            valEl.textContent = p + '%';
            bar.style.strokeDashoffset = C * (1 - p / 100);
            if (p < targetP) requestAnimationFrame(tick);
        };
        setTimeout(tick, 350);
    });

    // --- KEY REDEEMER ANIMATION ---
    document.querySelectorAll('.cryptic-licbox').forEach(root => {
        const input = root.querySelector('input'), btn = root.querySelector('.clb-btn'), stage = root.querySelector('.clb-stage'), statusEl = stage.querySelector('.clb-status'), success = stage.querySelector('.clb-success'), ptr = root.querySelector('.clb-pointer');
        const KEY_TEXT = root.dataset.key || 'Engine-123456-Key-1337';
        const T = { start: 500, type: 55, move: 650, click: 150, init: 1400, inject: 1400, success: 1200, loop: 900 };
        const relCenter = el => { const r = el.getBoundingClientRect(), b = root.getBoundingClientRect(); return { x: r.left - b.left + r.width/2, y: r.top - b.top + r.height/2 }; };
        const movePtr = (x, y, dur = T.move) => new Promise(res => { ptr.style.transition = `transform ${dur}ms ease`; ptr.style.transform = `translate(${x}px, ${y}px)`; setTimeout(res, dur); });
        const typeKey = async text => { input.value = ''; for (let ch of text) { input.value += ch; await wait(T.type + Math.random()*40); } };
        async function run(){ ptr.style.opacity = 0; stage.classList.remove('is-open'); success.classList.remove('show'); await wait(T.start); const ic = relCenter(input); ptr.style.opacity = 1; await movePtr(ic.x - 40, ic.y - 10, 320); await typeKey(KEY_TEXT); const bc = relCenter(btn); await wait(160); await movePtr(bc.x + 6, bc.y + 6); btn.classList.add('is-press'); await wait(T.click); btn.classList.remove('is-press'); stage.classList.add('is-open'); statusEl.textContent = "Initializing…"; await wait(T.init); statusEl.textContent = "Injecting…"; await wait(T.inject); statusEl.textContent = ""; stage.querySelector('.clb-spinner')?.classList.add('d-none'); success.classList.add('show'); await wait(T.success); stage.classList.remove('is-open'); stage.querySelector('.clb-spinner')?.classList.remove('d-none'); ptr.style.opacity = 0; input.value = ""; await wait(T.loop); run(); }
        run();
    });

    // --- CHAT ANIMATION ---
    document.querySelectorAll('.chat').forEach(chatEl => {
        const bubbles = [...chatEl.querySelectorAll('.bubble')];
        if (!bubbles.length) return;
        const resetAll = () => bubbles.forEach(b => { b.classList.remove('cf-in'); b.style.opacity = 0; b.style.transform = 'translateY(10px) scale(.96)'; });
        const loop = () => { resetAll(); let i = 0; const step = () => { if (i >= bubbles.length) return setTimeout(loop, 1600); const b = bubbles[i++]; b.classList.add('cf-in'); setTimeout(step, parseInt(b.dataset.delay || '800', 10)); }; setTimeout(step, 600); };
        resetAll(); loop();
    });

    // --- UI DEMO INTERACTIVITY ---
    document.querySelectorAll('.ui-demo').forEach(container => {
        container.querySelectorAll('.tab').forEach(tab => {
            tab.addEventListener('click', () => {
                container.querySelectorAll('.tab').forEach(t => t.classList.remove('is-active'));
                tab.classList.add('is-active');
                container.querySelectorAll('.ui-col').forEach(c => c.style.display = 'none');
                const content = container.querySelector(`.ui-col[data-tab-content="${tab.textContent.trim()}"]`);
                if(content) content.style.display = 'block';
            });
        });
        container.querySelectorAll('.tgl').forEach(toggle => {
            toggle.addEventListener('click', () => toggle.classList.toggle('is-checked'));
        });
        container.querySelectorAll('.slider').forEach(slider => {
            const handle = slider.querySelector('i');
            slider.addEventListener('mousedown', e => {
                e.preventDefault();
                const rect = slider.getBoundingClientRect();
                const move = moveE => { handle.style.left = Math.max(0, Math.min(100, ((moveE.clientX - rect.left) / rect.width) * 100)) + '%'; };
                document.addEventListener('mousemove', move);
                document.addEventListener('mouseup', () => document.removeEventListener('mousemove', move), { once: true });
            });
        });
        container.querySelectorAll('.key-binding').forEach(button => {
            button.addEventListener('click', () => button.classList.toggle('active'));
        });
    });
});
</script>