{#
  Product Page - V7 (Ultra-Modern Glassmorphism Redesign)
  Glassmorphism card, accent colors via var(--cl-accent), modern buy buttons.
  All Alpine.js logic preserved exactly.
#}

{% set imgScaleClass = ('object-scale-down' if global.properties.product_image_fit == 'scale-down' else 'object-cover') %}

<section class="component xpp-wrapper" data-component-id="{{ componentId }}">
  <div class="container py-5">

    <!-- MAIN CARD -->
    <div class="xpp-card">
      <div class="xpp-grid" x-data="productForm">

        <!-- LEFT: IMAGE -->
        <div class="xpp-left">
          <div class="xpp-hero-img">
            {% if product.image_urls|length > 0 %}
              <img src="{{ product.image_urls[0] }}" alt="{{ product.name }}" class="{{ imgScaleClass }}">
            {% elif product.image_url %}
              <img src="{{ product.image_url }}" alt="{{ product.name }}" class="{{ imgScaleClass }}">
            {% else %}
              <div class="xpp-img-placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" viewBox="0 0 16 16"><path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2l-2.218-.887zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z"/></svg>
              </div>
            {% endif %}
            <div class="xpp-img-gradient"></div>
          </div>
        </div>

        <!-- RIGHT: PURCHASE INFO -->
        <div class="xpp-right">

          <h1 class="xpp-title">{{ product.name }}</h1>

          {% if 'views' in liveStats or 'sales' in liveStats %}
            <div class="xpp-chips-row">
              {% if 'views' in liveStats %}
                <span class="xpp-chip">
                  <i class="xpp-dot" style="--c:#10d98d"></i>
                  <strong>{{ liveStats.views }}</strong>
                  <span class="xpp-chip-label">viewing</span>
                </span>
              {% endif %}
              {% if 'sales' in liveStats %}
                <span class="xpp-chip">
                  <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M7 18a2 2 0 1 1 0 4 2 2 0 0 1 0-4Zm10 0a2 2 0 1 1 0 3.999A2 2 0 0 1 17 18ZM3 4h2l3.6 7.59-1.35 2.45A2 2 0 0 0 7 16h10a2 2 0 0 0 1.79-1.11L21 8H7"></path></svg>
                  <strong>{{ liveStats.sales }}</strong>
                  <span class="xpp-chip-label">purchased</span>
                </span>
              {% endif %}
            </div>
          {% endif %}

          <div class="xpp-price" x-text="appCurrency.format(totalPrice, '{{ product.currency }}')"></div>
          <div class="xpp-sub-label">SELECT PRICE PER KEY</div>

          <!-- VARIANTS -->
          <div class="xpp-variants">
            {% for variant in product.variants %}
              <button
                type="button"
                class="xpp-variant-btn"
                :class="{ 'xpp-variant-active': activeVariant === {{ loop.index0 }} }"
                @click="activeVariant = {{ loop.index0 }}"
                {% if variant.stock === 0 %}disabled{% endif %}
              >
                {{ variant.name }}
              </button>
            {% endfor %}
          </div>

          <form @submit.prevent="buyNow">
            <!-- QUANTITY -->
            <div class="my-4">
              <label class="xpp-sub-label">QUANTITY</label>
              <div class="xpp-qty">
                <button @click="changeQuantity(quantity - 1)" type="button" :disabled="outOfStock || quantity <= minQuantity">-</button>
                <input type="number" name="quantity" x-model.number="quantity" :disabled="outOfStock">
                <button @click="changeQuantity(quantity + 1)" type="button" :disabled="outOfStock || quantity >= maxQuantity">+</button>
              </div>
            </div>

            <!-- BUY BUTTONS -->
            <div class="xpp-buy-btns">
              {% if not properties.hide_add_to_cart %}
                <button type="button" x-on:click="addToCart" class="xpp-btn-cart" :disabled="outOfStock || addingToCart">
                  <span x-show="!addingToCart && !addedToCart">Add to Cart</span>
                  <span x-show="addingToCart">Adding…</span>
                  <span x-show="addedToCart">Go to Cart</span>
                </button>
              {% endif %}
              {% if not properties.hide_buy_now %}
                <button type="submit" class="xpp-btn-buy" :disabled="outOfStock || buyingNow">
                  <span x-show="!buyingNow">Buy Now</span>
                  <span x-show="buyingNow">Processing…</span>
                </button>
              {% endif %}
            </div>
          </form>

        </div>
      </div>
    </div>

    <!-- DESCRIPTION CARD -->
    <div class="xpp-desc-card">
      <div class="xpp-desc-head">
        <span class="xpp-pill">Description</span>
      </div>
      <div class="xpp-desc-body editor">
        {{ product.description | safe }}
      </div>
    </div>

  </div>
</section>

<style>
/* ── Wrapper ── */
.xpp-wrapper {
  color: #f5f7ff;
  background-color: var(--cl-background-primary, #0a0a0a);
}

/* ── Main Card ── */
.xpp-card {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 1.5rem;
  padding: 2rem;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 25px 60px rgba(0,0,0,0.6);
}
.xpp-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}
@media (min-width: 992px) {
  .xpp-grid { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 3rem; }
}

/* ── Image ── */
.xpp-hero-img {
  position: relative;
  border-radius: 1rem;
  overflow: hidden;
  aspect-ratio: 16/9;
  background: var(--cl-background-secondary, #141414);
}
.xpp-hero-img img {
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.5s cubic-bezier(.25,.8,.25,1);
}
.xpp-hero-img:hover img { transform: scale(1.03); }
.xpp-img-placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  color: rgba(255,255,255,0.1);
}
.xpp-img-gradient {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 40%;
  background: linear-gradient(to top, rgba(8,10,13,0.7), transparent);
  pointer-events: none;
}

/* ── Right Column ── */
.xpp-right { display: flex; flex-direction: column; }

.xpp-title {
  font-size: 2.2rem;
  font-weight: 800;
  margin-bottom: 0.75rem;
  line-height: 1.2;
  background: linear-gradient(135deg, #fff 0%, #c8d0e8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Live chips */
.xpp-chips-row { display: flex; gap: 0.5rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
.xpp-chip {
  display: flex; align-items: center; gap: 0.35rem;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  padding: 0.3rem 0.7rem;
  border-radius: 8px;
  font-size: 0.75rem;
  backdrop-filter: blur(8px);
}
.xpp-dot { width: 8px; height: 8px; border-radius: 50%; background-color: var(--c); flex-shrink: 0; }
.xpp-chip strong { font-weight: 700; color: #fff; }
.xpp-chip-label { color: rgba(255,255,255,0.5); }

/* Price */
.xpp-price {
  font-size: 2.4rem;
  font-weight: 800;
  color: var(--cl-accent, #e53e3e);
  text-shadow: 0 0 24px rgba(0,0,0,0.5);
  margin-bottom: 0.25rem;
  line-height: 1;
}
.xpp-sub-label {
  font-size: 0.65rem;
  font-weight: 700;
  color: rgba(255,255,255,0.35);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}

/* Variants */
.xpp-variants {
  display: flex; flex-wrap: wrap; gap: 0.5rem;
  margin-bottom: 0.5rem;
}
.xpp-variant-btn {
  padding: 0.4rem 1rem;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 99px;
  color: rgba(255,255,255,0.65);
  font-size: 0.82rem;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s, color 0.2s;
}
.xpp-variant-btn:hover:not(:disabled) { background: rgba(255,255,255,0.10); color: #fff; }
.xpp-variant-btn.xpp-variant-active {
  background: var(--cl-accent, #e53e3e);
  border-color: var(--cl-accent, #e53e3e);
  color: #fff;
  box-shadow: 0 0 14px rgba(0,0,0,0.3);
}
.xpp-variant-btn:disabled { opacity: 0.35; cursor: not-allowed; }

/* Quantity stepper */
.xpp-qty {
  display: flex;
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 10px;
  overflow: hidden;
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(8px);
  max-width: 180px;
}
.xpp-qty input {
  flex: 1; background: transparent; color: #fff;
  text-align: center; border: none;
  padding: 0.55rem; font-size: 1rem;
}
.xpp-qty input:focus { outline: none; }
.xpp-qty button {
  width: 42px; background: transparent; border: none;
  color: #fff; font-size: 1.3rem;
  transition: background 0.2s;
  cursor: pointer;
}
.xpp-qty button:not(:disabled):hover { background: rgba(255,255,255,0.08); }
.xpp-qty button:disabled { opacity: 0.35; cursor: not-allowed; }

/* Buy buttons */
.xpp-buy-btns {
  display: flex; gap: 0.85rem; margin-top: 1.5rem; flex-wrap: wrap;
}
.xpp-buy-btns button {
  padding: 0.8rem 1.4rem;
  border-radius: 10px;
  font-size: 1rem; font-weight: 700;
  transition: all 0.22s cubic-bezier(.25,.8,.25,1);
  cursor: pointer;
}
.xpp-btn-cart {
  flex: 1;
  background: var(--cl-accent, #e53e3e);
  border: none;
  color: #fff;
  box-shadow: 0 6px 22px rgba(0,0,0,0.4);
}
.xpp-btn-cart:not(:disabled):hover {
  opacity: 0.88;
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(0,0,0,0.5);
}
.xpp-btn-buy {
  background: transparent;
  border: 1px solid var(--cl-accent, #e53e3e);
  color: var(--cl-accent, #e53e3e);
  min-width: 120px;
}
.xpp-btn-buy:not(:disabled):hover {
  background: var(--cl-accent, #e53e3e);
  color: #fff;
  transform: translateY(-2px);
}
.xpp-buy-btns button:disabled { opacity: 0.5; cursor: not-allowed; transform: none !important; }

/* Description card */
.xpp-desc-card {
  margin-top: 1.75rem;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 1rem;
  overflow: hidden;
}
.xpp-desc-head {
  padding: 0.85rem 1.5rem;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.xpp-pill {
  background: var(--cl-accent, #e53e3e);
  padding: 0.25rem 0.85rem;
  border-radius: 99px;
  font-size: 0.8rem;
  font-weight: 700;
  color: #fff;
}
.xpp-desc-body {
  padding: 1.5rem;
  color: rgba(255,255,255,0.65);
  line-height: 1.75;
}
</style>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('productForm', () => ({
      product: {{ product | json }},
      activeVariant: 0,
      quantity: 1,
      addingToCart: false, addedToCart: false,
      buyingNow: false, buyNowError: null,

      init() {
        const firstAvailable = this.product.variants.findIndex(v => v.stock !== 0);
        this.activeVariant = firstAvailable >= 0 ? firstAvailable : 0;
        this.quantity = this.variant.quantity_min || 1;
        this.$watch('activeVariant', () => {
          this.quantity = this.variant.quantity_min || 1;
          this.addedToCart = false;
        });
      },

      get variant() { return this.product.variants[this.activeVariant]; },
      get outOfStock() { return this.variant && this.variant.stock === 0; },
      get minQuantity() { return this.variant.quantity_min || 1; },
      get maxQuantity() { return this.variant.quantity_max || 999; },
      get totalPrice() { return (this.variant.price * this.quantity).toFixed(2); },

      changeQuantity(newQty) {
        this.quantity = Math.max(this.minQuantity, Math.min(newQty, this.maxQuantity));
      },

      addToCart() {
        if (this.addedToCart) { window.location.href = '{{ '/cart' | shopUrl }}'; return; }
        this.addingToCart = true;
        this.appCart.add(this.product.id, this.variant.id, this.quantity);
        setTimeout(() => { this.addedToCart = true; this.addingToCart = false; }, 1000);
      },

      async buyNow() {
        this.buyingNow = true; this.buyNowError = null;
        console.log("Buying now:", { productId: this.product.id, variantId: this.variant.id, quantity: this.quantity });
        setTimeout(() => { this.buyingNow = false; }, 2000);
      }
    }));
  });
</script>