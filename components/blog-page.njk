<section class="component" data-component-id="{{ componentId }}">
  <div class="container mx-auto">
    <div class="py-32 relative mb-8">
      <div class="m-auto absolute inset-0 -z-10 aspect-square rounded-full blur-[200px] bg-accent-500/50 max-w-4xl -translate-y-1/2 w-[65%]" aria-hidden="true"></div>
      <div class="container mx-auto relative">
        <div class="mx-auto max-w-md text-center">
          <div class="text-center mb-4">
            <span class="inline-block px-6 py-2 rounded-full border-2 border-white/5 bg-white/5 text-accent-100 text-sm font-semibold hover:translate-y-[-2px] transition-transform duration-300 ease-in-out" data-dsr>
              {{ blogPosts.total }} {{ "Posts" if blogPosts.total > 1 else "Post" }}
            </span>
          </div>
          <h1 class="text-5xl !leading-[1.125] font-bold text-t-primary mb-4" data-dsr>
            {{ properties.title | renderString }}
          </h1>
        </div>
      </div>
    </div>

    <div class="px-4 mb-16 lg:mb-32" data-dsr>
      {% if blogPosts.data|length > 0 %}
        {% if properties.enlarge_newest_post %}
          <div class="hidden xl:block">
            {% render_snippet "blog-post-large-card.njk", blogPost=blogPosts.data[0] %}
          </div>
        {% endif %}

        <div class="grid grid-cols-1 items-start md:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-8 mb-4 lg:mb-8">
          {% for blogPost in blogPosts.data %}
            <div class="{{ 'xl:hidden' if properties.enlarge_newest_post and loop.first }}">
              {% render_snippet "blog-post-card.njk", blogPost=blogPost %}
            </div>
          {% endfor %}
        </div>

        {% if blogPosts.last_page > 1 %}
          {% render_snippet "pagination.njk", paginator=blogPosts %}
        {% endif %}
      {% else %}
        <p class="text-t-primary/50 text-lg text-center" data-dsr>No Blog Posts Yet.</p>
      {% endif %}
    </div>
  </div>
</section>