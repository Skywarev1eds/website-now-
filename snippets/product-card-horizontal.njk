<style>
.status-badge-horizontal {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  font-weight: 600;
  line-height: 1.25rem;
  text-transform: capitalize;
}
.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

/* Farben und Glow-Effekte für Punkt und Text */
.status-frozen { color: #54a3f2; text-shadow: 0 0 8px rgba(84, 163, 242, 0.7); }
.status-frozen .status-dot { background-color: #54a3f2; box-shadow: 0 0 6px #54a3f2; }

.status-high-risk { color: #a855f7; text-shadow: 0 0 8px rgba(168, 85, 247, 0.7); }
.status-high-risk .status-dot { background-color: #a855f7; box-shadow: 0 0 6px #a855f7; }

.status-testing { color: #f1c40f; text-shadow: 0 0 8px rgba(241, 196, 15, 0.7); }
.status-testing .status-dot { background-color: #f1c40f; box-shadow: 0 0 6px #f1c40f; }

.status-undetected { color: #2ecc71; text-shadow: 0 0 8px rgba(46, 204, 113, 0.7); }
.status-undetected .status-dot { background-color: #2ecc71; box-shadow: 0 0 6px #2ecc71; }

.status-updating { color: #3498db; text-shadow: 0 0 8px rgba(52, 152, 219, 0.7); }
.status-updating .status-dot { background-color: #3498db; box-shadow: 0 0 6px #3498db; }

.status-discontinued { color: #95a5a6; text-shadow: 0 0 8px rgba(149, 165, 166, 0.7); }
.status-discontinued .status-dot { background-color: #95a5a6; box-shadow: 0 0 6px #95a5a6; }

.status-detected { color: #ff4d4d; text-shadow: 0 0 8px rgba(255, 77, 77, 0.7); }
.status-detected .status-dot { background-color: #ff4d4d; box-shadow: 0 0 6px #ff4d4d; }

.status-default { color: #a0aec0; }
.status-default .status-dot { background-color: #a0aec0; }


.product-card-horizontal {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 0.75rem;
  border-radius: 0.5rem;
  transition: background-color 0.2s ease-in-out;
  text-decoration: none;
}
.product-card-horizontal:hover {
  background-color: rgba(255, 255, 255, 0.05);
}
.product-card-horizontal:hover .arrow-icon {
  transform: translateX(4px);
}
.product-image-wrapper {
  flex-shrink: 0;
}
.product-image-horizontal {
  width: 3rem;
  height: 3rem;
  border-radius: 0.375rem;
  object-fit: cover;
}
.product-info-horizontal {
  flex-grow: 1;
  margin-left: 1rem;
  text-align: left;
}
.product-name-horizontal {
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.product-meta-horizontal {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-top: 0.25rem;
  color: #a0aec0;
  font-size: 0.875rem;
}
.arrow-icon-wrapper {
  margin-left: 1rem;
  color: #a0aec0;
  transition: transform 0.2s ease-in-out;
}
</style>

<a href="/product/{{ product.path }}" class="product-card-horizontal">
  <div class="product-image-wrapper">
    {% set imageUrl = product.image_urls[0] if product.image_urls and product.image_urls|length > 0 else product.image_url %}
    <img src="{{ imageUrl | default('https://i.ibb.co/0V8tqcYT/logo.png') }}" alt="{{ product.name }}" class="product-image-horizontal">
  </div>
  
  <div class="product-info-horizontal">
    <h4 class="product-name-horizontal">{{ product.name }}</h4>
    <div class="product-meta-horizontal">
      
      {% if product.status_text is defined and product.status_text %}
        {% set status_lower = product.status_text|lower|replace(' ', '-') %}
        {% set status_class = 'status-' + status_lower %}
        
        <div class="status-badge-horizontal {{ status_class }}">
          <span class="status-dot"></span>
          <span>{{ product.status_text }}</span>
        </div>
      {% endif %}

      {% if product.price is defined and product.price is not null %}
        <span class="price">{{ formatPrice(product.price, product.currency) }}</span>
      {% endif %}

    </div>
  </div>
  
  <div class="arrow-icon-wrapper">
    <i class="fas fa-arrow-right arrow-icon"></i>
  </div>
</a>