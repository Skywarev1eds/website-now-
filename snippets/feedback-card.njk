{# --- STIL FÜR DIE KARTE --- #}
<style>
  .feedback-card {
    width: 380px;
    flex-shrink: 0;
    background: linear-gradient(145deg, #2a2d3d, #1e202b);
    border: 1px solid #3c3f52;
    border-radius: 1rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .feedback-card:hover {
    border-color: color-mix(in srgb, var(--cl-accent) 25%, transparent);
    box-shadow: 0 0 20px -5px color-mix(in srgb, var(--cl-accent) 50%, transparent);
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .testimonial-stars { display: flex; gap: 0.25rem; }
  .testimonial-stars svg { width: 1.2rem; height: 1.2rem; }
  .testimonial-date { font-size: 0.85rem; color: #a0aec0; }
  .testimonial-message {
    color: #d1d5db;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0.5rem 0 1.5rem 0;
    flex-grow: 1;
  }
  .card-footer {
    display: flex;
    align-items: center;
    border-top: 1px solid #3c3f52;
    padding-top: 1rem;
    gap: 0.75rem;
  }
  .card-footer-icon svg { width: 1.25rem; height: 1.25rem; color: #a0aec0; }
  .testimonial-product { font-weight: 500; color: #e2e8f0; font-size: 0.9rem; }
</style>

{# --- FINALE HTML-STRUKTUR --- #}
{% if feedback %}
<div class="feedback-card">
  <div>
    <div class="card-top">
      <div class="testimonial-stars">
        {% if feedback.rating and feedback.rating > 0 %}
          {% for i in [1, 2, 3, 4, 5] %}
            {% if i <= feedback.rating %}
              <svg fill="var(--cl-accent)" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
            {% else %}
              <svg fill="#4a5568" viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/></svg>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
      <span class="testimonial-date js-format-date">{{ feedback.created_at }}</span>
    </div>
    <p class="testimonial-message">{{ feedback.message or 'No message provided.' }}</p>
  </div>

  <div class="card-footer">
    <div class="card-footer-icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M2.25 7.125A2.25 2.25 0 0 1 4.5 4.875h15a2.25 2.25 0 0 1 2.25 2.25v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25v-10.5Zm1.5 0v10.5a.75.75 0 0 0 .75.75h15a.75.75 0 0 0 .75-.75v-10.5a.75.75 0 0 0-.75-.75h-15a.75.75 0 0 0-.75.75ZM5.25 3a.75.75 0 0 0 0 1.5h13.5a.75.75 0 0 0 0-1.5H5.25Z"/></svg>
    </div>
    {# --- KORRIGIERTER ZUGRIFF AUF DEN PRODUKTNAMEN --- #}
    <span class="testimonial-product">
      {% if feedback.items and feedback.items[0] and feedback.items[0].product and feedback.items[0].product.name %}
        {{ feedback.items[0].product.name }}
      {% else %}
        Deleted Product
      {% endif %}
    </span>
  </div>
</div>
{% endif %}

{# --- JAVASCRIPT-FIX FÜR DAS DATUM (unverändert) --- #}
<script>
  if (!window.hasFormattedFeedbackDates) {
    const formatFeedbackDates = () => {
      const dateElements = document.querySelectorAll('.js-format-date:not([data-formatted])');
      const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
      dateElements.forEach(el => {
        const rawDate = el.textContent.trim();
        const dateObj = new Date(rawDate);
        if (!isNaN(dateObj.getTime())) {
          const day = dateObj.getDate();
          const monthName = months[dateObj.getMonth()];
          const year = dateObj.getFullYear();
          el.textContent = `${monthName} ${day}, ${year}`;
        }
        el.dataset.formatted = 'true';
      });
    };
    document.addEventListener('DOMContentLoaded', formatFeedbackDates);
    window.hasFormattedFeedbackDates = true;
    const observer = new MutationObserver(() => {
        if (document.querySelector('.js-format-date:not([data-formatted])')) {
            formatFeedbackDates();
        }
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }
</script>