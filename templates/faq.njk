<section class="faq-section py-5 component" data-component-id="{{ componentId }}">
  <style>
    :root {
      --cl-accent: {{ global.properties.theme_color | default('#e53e3e') }};
      --cl-accent-rgb: 229, 62, 62; /* RGB for #e53e3e */
      --cl-background-primary-rgb: 20, 20, 20; /* RGB for #141414 */
    }
  </style>
  <div class="container">
    <div class="row align-items-center">
      <!-- FAQ Column (Left) -->
      <div class="col-lg-6" style="position: relative;">
        
        <div class="d-flex flex-column gap-3" id="faq-accordion">
          {% for item in properties.items %}
          <div class="faq-item">
            <div class="faq-header">
              <div class="icon"><i class="{{ item.icon | default('fa-solid fa-rocket') }}"></i></div>
              <span class="question">{{ item.question | default('How do I get started?') }}</span>
              <i class="fa-solid fa-plus toggle-icon"></i>
            </div>
            <div class="faq-body">
              {{ item.answer | default('Simply browse our products and make a purchase.') }}
            </div>
          </div>
          {% endfor %}
        </div>
      </div>

      <!-- Help Section (Right) -->
      <div class="col-lg-6">
        <div class="help-section">
          <div class="help-content">
            <h3>Need <span style="color: var(--cl-accent);">Help</span>?</h3>
            <p>Our support team is here to assist you 24/7. Get instant help through our Discord Server.</p>
            <div class="help-buttons">
              <a href="/status" class="btn btn-transparent">
                <i class="fa-solid fa-bars"></i>
                Status
              </a>
              <a href="{{ shop.discord_url }}" class="btn btn-transparent">
                <i class="fab fa-discord"></i>
                Join Discord
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
    .faq-section {
      background: transparent;
      padding-top: 5rem !important; /* ANGEPASST */
      padding-bottom: 5rem !important; /* ANGEPASST */
    }
    .faq-item {
      border: 2px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 1.2rem 1.5rem;
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      transition: border-color 0.3s ease, background 0.3s ease;
      overflow: hidden;
      --border-color: var(--cl-accent);
    }
    .faq-item:hover { border-color: var(--border-color); }
    .faq-header { display: flex; align-items: center; gap: 1rem; justify-content: space-between; cursor: pointer; }
    .faq-header .question { flex-grow: 1; font-weight: 600; color: #fff; text-align: left; }
    .faq-body { max-height: 0; opacity: 0; overflow: hidden; color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; transition: all 0.4s ease-in-out; }
    .faq-item.open .faq-body { max-height: 500px; opacity: 1; margin-top: 1rem; }
    .icon { width: 38px; height: 38px; background: var(--border-color); color: #fff; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
    .toggle-icon { font-size: 1.2rem; transition: transform 0.3s ease; color: var(--border-color); }
    .faq-item.open .toggle-icon { transform: rotate(45deg); }
    
    .help-section {
      min-height: 470px;
      background-image: url('https://i.imgur.com/jiAOXvK.jpeg');
      background-size: cover;
      background-position: center;
      border-radius: 12px;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .help-section::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(var(--cl-accent-rgb), 0.15) 0%, rgba(var(--cl-accent-rgb), 0.15) 65%, rgba(var(--cl-background-primary-rgb), 0.88) 85%, rgba(var(--cl-background-primary-rgb), 1) 100%);
      z-index: 1;
      backdrop-filter: blur(2px);
    }
    .help-content { position: relative; z-index: 2; text-align: center; color: white; padding: 2rem; max-width: 400px; }
    .help-content h3 { font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem; color: #fff; }
    .help-content p { font-size: 1.1rem; margin-bottom: 2rem; color: #e2e8f0; line-height: 1.6; }
    .help-buttons { display: flex; flex-direction: row; gap: 1rem; justify-content: center; }
    .help-buttons .btn { padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600; text-decoration: none; transition: all 0.3s ease; border: 2px solid rgba(255, 255, 255, 0.3); display: flex; align-items: center; gap: 0.5rem; white-space: nowrap; }
    .help-buttons .btn-transparent { background: transparent; color: white; border-color: rgba(255, 255, 255, 0.3); }
    .help-buttons .btn-transparent:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.5); transform: translateY(-2px); }

    @media (max-width: 991.98px) { .col-lg-6:first-child { margin-bottom: 2rem; } }
    @media (max-width: 767.98px) {
      .help-buttons { flex-direction: column; align-items: center; gap: 0.75rem; }
      .help-buttons .btn { width: 100%; max-width: 250px; justify-content: center; }
    }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const accordion = document.getElementById('faq-accordion');
    if (accordion) {
      const headers = accordion.querySelectorAll('.faq-header');
      headers.forEach(header => {
        header.addEventListener('click', () => {
          const item = header.closest('.faq-item');
          const wasOpen = item.classList.contains('open');
          
          // Close all items
          accordion.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
          
          // Toggle current item
          if (!wasOpen) {
            item.classList.add('open');
          }
        });
      });
    }
  });
</script>