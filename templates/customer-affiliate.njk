<div class="container mx-auto px-4 my-16 lg:my-32 relative">
  <div class="m-auto absolute inset-x-0 top-0 -z-10 aspect-square rounded-full blur-[300px] bg-accent-500/50 max-w-4xl -translate-y-1/2 w-[65%]" aria-hidden="true"></div>

  <div class="w-full mx-auto flex flex-col gap-4 md:gap-6 lg:gap-8 lg:flex-row">
    <div class="lg:flex-1">
      {% render_snippet "customer-sidebar.njk" %}
    </div>
    <div class="lg:w-3/4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex flex-col p-4 md:p-6 lg:p-7 bg-white/5 backdrop-blur-2xl rounded-xl border-2 border-white/5">
          <h3 class="text-lg text-t-primary/80">
            Your Affiliate Link
          </h3>
          <p class="text-sm text-t-primary/60 mt-1">
            Share your affiliate link with friends and earn rewards when they make purchases.
          </p>
          <div
            class="flex justify-between items-center gap-4 mt-4"
            x-data="{
              copied: false,
              copy() {
                const affiliateLink = $refs.affiliateLink;
                navigator.clipboard.writeText(affiliateLink.textContent).then(() => {
                  this.copied = true;
                  setTimeout(() => {
                    this.copied = false;
                  }, 2000);
                })
              }
            }"
          >
            <button
              type="button"
              class="text-base text-t-primary font-semibold truncate"
              x-ref="affiliateLink"
              @click="copy()"
              :disabled="copied"
            >
              <span>{{ shop.url }}/?a={{ shop_customer.affiliate_code }}</span>
            </button>
            <template x-if="copied">
              <span class="text-base text-accent-500">Copied!</span>
            </template>
          </div>
        </div>
        <div class="flex flex-col p-4 md:p-6 lg:p-7 bg-white/5 backdrop-blur-2xl rounded-xl border-2 border-white/5">
          <h3 class="text-lg text-t-primary/80">
            Affiliate Rewards
          </h3>
          <p class="text-sm text-t-primary/60 mt-1">
            You earn a percentage of the total invoice amount for each purchase made through your affiliate link.
          </p>
          <p class="mt-4 text-base text-t-primary font-semibold">
            {{ shop.affiliate_percentage }}%
          </p>
        </div>
        <a href="{{ '/customer/balance' | shopUrl }}" class="flex items-center gap-2 justify-between p-4 md:px-6 lg:px-7 bg-white/5 backdrop-blur-2xl rounded-xl border-2 border-white/5 transition ease-in-out duration-300 hover:bg-white/10">
          <h3 class="text-base text-t-primary/80">
            View Your Balance
          </h3>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="currentColor" d="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h6q.425 0 .713.288T12 4t-.288.713T11 5H5v14h14v-6q0-.425.288-.712T20 12t.713.288T21 13v6q0 .825-.587 1.413T19 21zM19 6.4L10.4 15q-.275.275-.7.275T9 15t-.275-.7t.275-.7L17.6 5H15q-.425 0-.712-.288T14 4t.288-.712T15 3h5q.425 0 .713.288T21 4v5q0 .425-.288.713T20 10t-.712-.288T19 9z"/></svg>
        </a>
        <a href="{{ '/customer/balance' | shopUrl }}" class="flex items-center gap-2 justify-between p-4 md:px-6 lg:px-7 bg-white/5 backdrop-blur-2xl rounded-xl border-2 border-white/5 transition ease-in-out duration-300 hover:bg-white/10">
          <h3 class="text-base text-t-primary/80">
            View Your Balance History
          </h3>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24"><!-- Icon from Material Symbols by Google - https://github.com/google/material-design-icons/blob/master/LICENSE --><path fill="currentColor" d="M5 21q-.825 0-1.412-.587T3 19V5q0-.825.588-1.412T5 3h6q.425 0 .713.288T12 4t-.288.713T11 5H5v14h14v-6q0-.425.288-.712T20 12t.713.288T21 13v6q0 .825-.587 1.413T19 21zM19 6.4L10.4 15q-.275.275-.7.275T9 15t-.275-.7t.275-.7L17.6 5H15q-.425 0-.712-.288T14 4t.288-.712T15 3h5q.425 0 .713.288T21 4v5q0 .425-.288.713T20 10t-.712-.288T19 9z"/></svg>
        </a>
      </div>
      <div class="mt-4">
        <div class="flex flex-col p-4 md:p-6 lg:p-7 bg-white/5 backdrop-blur-2xl rounded-xl border-2 border-white/5">
          <h3 class="text-lg text-t-primary/80">
            Referred Users
          </h3>
          <div class="mt-2 rounded-md overflow-hidden">
            {% if referred_customers.data.length > 0 %}
              <table class="w-full text-left text-sm text-t-primary/80">
                <thead class="text-xs text-t-primary/60 uppercase bg-white/5">
                  <tr>
                    <th scope="col" class="px-6 py-3">E-mail Address</th>
                    <th scope="col" class="px-6 py-3">Amount Earned</th>
                    <th scope="col" class="px-6 py-3">Date</th>
                  </tr>
                </thead>
                <tbody>
                  {% for customer in referred_customers.data %}
                    <tr class="border-b border-white/5">
                      <td class="px-6 py-4 whitespace-nowrap capitalize">
                        {{ customer.email }}
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap capitalize">
                        <span x-text="appCurrency.format({{ customer.affiliate_referrer_earnings }}, 'USD')">
                          {{ formatPrice(customer.affiliate_referrer_earnings, 'USD') }}
                        </span>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        {{ customer.created_at | formatDateTime }}
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            {% else %}
              <p class="text-sm text-t-primary/60">
                No referred customers yet.
              </p>
            {% endif %}
          </div>
          {% if referred_customers.last_page > 1 %}
            {% render_snippet "pagination.njk", paginator=referred_customers %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<div class="components">
  {% for componentId in components_order %}
    {% render_component componentId %}
  {% endfor %}
</div>